# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string used only by scripts/db-push.mjs (session pooler).
# Not required at runtime.
SUPABASE_DB_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Public origin used in booking links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
